# Server
PORT=4000

# Google Gemini (Free Tier - Google AI Studio)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Twilio (Free Sandbox for WhatsApp + SMS)
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+1XXXXXXXXXX

# Escalation timing (minutes) - matches the 3-tier WhatsApp loop
REMINDER_TIER_1_MINUTES=0
REMINDER_TIER_2_MINUTES=1
REMINDER_TIER_3_MINUTES=3

# SQLite database file path
DB_PATH=./cliniguide.db
